# Local development for the signup API (docker compose up -d --build).
# Production values are written onto the server by .github/workflows/api.yml —
# nothing here is ever the source of truth for the live system.

POSTGRES_DB=maiacity
POSTGRES_USER=maiacity
POSTGRES_PASSWORD=maiacity
POSTGRES_PORT=5433

API_PORT=3100

# WebAuthn: the relying party is the site the page is served from.
RP_ID=localhost
RP_NAME=maiaCITY
SITE_ORIGIN=http://localhost:5173

# Empty locally: the cookie stays host-only and plain http is allowed.
# In production this is .maia.city, which makes the cookie first-party for
# both the site and the api subdomain.
COOKIE_DOMAIN=

# fal.ai — voice synthesis for the journal films (https://fal.ai/dashboard/keys)
FAL_API_KEY=

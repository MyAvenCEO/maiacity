{
  "scope": "Scheduling models only: no extracted-code, cryptographic, durability or elapsed-time proof. The README retains the core security mapping.",
  "contracts": [
    {
      "model": "avendb/spec/AvenDB/WorldSnapshot.lean",
      "invariant": "frozen serialization excludes later live state",
      "implementation": "avendb/crates/avendb-net/src/run.rs",
      "test": "avendb/crates/avendb-net/src/run.rs",
      "testName": "held_world_encoding_does_not_block_authorized_local_work"
    },
    {
      "model": "avendb/spec/AvenDB/NodeLoop.lean",
      "invariant": "a wake is never lost: owed to the attempt in flight, or waiting for the lane's backoff",
      "implementation": "avendb/crates/avendb-net/src/node_loop.rs",
      "test": "avendb/crates/avendb-net/src/node_loop.rs",
      "testName": "one_attempt_in_flight_and_a_wake_meanwhile_is_owed"
    },
    {
      "model": "avendb/spec/AvenDB/ListenerRelease.lean",
      "invariant": "listener ownership ends at awaited shutdown",
      "implementation": "avendb/crates/avendb-net/src/transports/control.rs",
      "test": "avendb/crates/avendb-net/tests/transport_control.rs",
      "testName": "concurrent_shutdown_releases_listener_port_while_node_is_retained"
    },
    {
      "model": "avendb/spec/AvenDB/DurableAnnounce.lean",
      "invariant": "authoritative persistence precedes announcement eligibility",
      "implementation": "avendb/crates/avendb-net/src/edits.rs",
      "test": "avendb/crates/avendb-net/src/edits.rs",
      "testName": "durable_entry_wakes_announcements_before_optional_view_save_finishes"
    },
    {
      "model": "avendb/spec/AvenDB/WorldReads.lean",
      "invariant": "single-flight and post-call freshness",
      "implementation": "src/lib/avendb/world-reader.js",
      "test": "src/lib/avendb/world-reader.test.js",
      "testName": ""
    },
    {
      "model": "avendb/spec/AvenDB/LocalWrite.lean",
      "invariant": "local acceptance does not wait for summary publication",
      "implementation": "src/lib/avendb/local-write.js",
      "test": "src/lib/avendb/local-write.test.js",
      "testName": ""
    },
    {
      "model": "avendb/spec/AvenDB/ProofWorker.lean",
      "invariant": "only the idle owning verifier can be released",
      "implementation": "game/code/sources/proof-worker.js",
      "test": "game/code/sources/proof-worker.test.js",
      "testName": ""
    },
    {
      "model": "avendb/spec/AvenDB/ShelfIndex.lean",
      "invariant": "index == rebuild(log): an index caught up from an honest slot is the index built from the log, with one root (I1, I2, I4)",
      "implementation": "avendb/crates/avendb-net/src/shelf_index.rs",
      "test": "avendb/crates/avendb-net/src/shelf_index_tests.rs",
      "testName": "index_is_the_rebuild_of_its_log_at_every_step"
    },
    {
      "model": "avendb/spec/AvenDB/ShelfIndex.lean",
      "invariant": "a crash at any write, a torn slot or a rewritten log opens the log's own index (I3)",
      "implementation": "avendb/crates/avendb-net/src/shelf_index.rs",
      "test": "avendb/crates/avendb-net/src/shelf_index_tests.rs",
      "testName": "a_crash_at_any_write_opens_the_index_of_the_log"
    },
    {
      "model": "avendb/spec/AvenDB/Freshness.lean",
      "invariant": "every read is stamped current, offline as of its last current read, or behind; an action sheet opens by itself only from current data",
      "implementation": "avendb/crates/avendb-net/src/run.rs",
      "test": "avendb/crates/avendb-net/src/live_tests.rs",
      "testName": "every_read_is_offline_behind_or_current_as_its_peers_say"
    },
    {
      "model": "avendb/spec/AvenDB/SharedIndex.lean",
      "invariant": "the shared index after each save is the rebuild of what the device's edits say, with one root (X1, X2, X4)",
      "implementation": "avendb/crates/avendb-net/src/shared_index.rs",
      "test": "avendb/crates/avendb-net/src/shared_index_tests.rs",
      "testName": "after_every_save_the_index_is_the_rebuild_with_its_root"
    },
    {
      "model": "avendb/spec/AvenDB/SharedIndex.lean",
      "invariant": "an entry put again takes out every row the index held of it and puts its new rows; a crash at any write is stepped on to the rebuild (X3, ShelfIndex I3)",
      "implementation": "avendb/crates/avendb-net/src/shared_index.rs",
      "test": "avendb/crates/avendb-net/src/shared_index_tests.rs",
      "testName": "a_crash_at_any_write_leaves_an_index_the_next_save_brings_to_the_rebuild"
    },
    {
      "model": "avendb/spec/AvenDB/ToldIndex.lean",
      "invariant": "the told index after each tell says what Rows says and is its rebuild, with one root (T1)",
      "implementation": "avendb/crates/avendb-net/src/told_index.rs",
      "test": "avendb/crates/avendb-net/src/told_index_tests.rs",
      "testName": "after_every_tell_the_index_says_what_rows_says_and_is_its_rebuild"
    },
    {
      "model": "avendb/spec/AvenDB/ToldIndex.lean",
      "invariant": "a crash at any write of a tell loses that tell alone, which told again gives the same rows (T2)",
      "implementation": "avendb/crates/avendb-net/src/told_index.rs",
      "test": "avendb/crates/avendb-net/src/told_index_tests.rs",
      "testName": "a_crash_at_any_write_loses_that_tell_alone_which_comes_again"
    }
  ]
}

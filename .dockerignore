# Only the API, the shared rules and the code entries go into the image — never the site, its
# images, or anyone's node_modules.
*
!api/package.json
!api/bun.lock
!api/src
!game
!code
# the vault's Rust workspace, for vault-server (never its build output)
!vault
vault/target
# avenDB's crates, which the vault's Mac app links by path: present so cargo can load the workspace, never built
!avendb
avendb/target
vault/app/gen

.DS_Store
Thumbs.db

# Env
.env
.env.*
!.env.example
!.env.test

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Video masters live in Bunny Stream, not in git
static/**/*.mp4
static/**/*.mov

# Every media file lives in the media library — production Postgres, by CID, served from the CDN; the site loads
# each through asset() and the manifest. `bun media sync` puts them there; git does not carry them. static/ keeps
# only what is not media (robots.txt, the sandbox's map data).
static/**/*.jpg
static/**/*.jpeg
static/**/*.png
static/**/*.webp
static/**/*.gif
static/**/*.svg
static/**/*.mp3
static/**/*.wav
static/**/*.ogg
static/**/*.pdf

# The local mirror of the media library: every file as <cid>.<ext> (`bun media library`)
/library/

# Voice takes and previews (`bun voice`): their bytes live in the media library; the designed voices stay in git
/studio/*
!/studio/voices.json

# the local database's manifest (bun media seed --local): the site loads unsynced files from the local API
/src/lib/media/manifest.local.json

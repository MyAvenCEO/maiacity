node_modules

# Output
.output
.vercel
.netlify
.wrangler
/.svelte-kit
/build
/theos/target/
/aven/db/target/
/aven/db/target-wasm/
/theos/app/gen/
# Leftover generated sidecars from older app builds
/theos/app/binaries/

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.*
!.env.example
!.env.test

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Video masters live in Bunny Stream, not in git
maia/site/static/**/*.mp4
maia/site/static/**/*.mov

# Every media file lives in the media library — production Postgres, by CID, served from the CDN; the site loads
# each through asset() and the manifest. `bun media sync` puts them there; git does not carry them. maia/site/static/ keeps
# only what is not media (robots.txt, the sandbox's map data).
maia/site/static/**/*.jpg
maia/site/static/**/*.jpeg
maia/site/static/**/*.png
maia/site/static/**/*.webp
maia/site/static/**/*.gif
maia/site/static/**/*.svg
maia/site/static/**/*.mp3
maia/site/static/**/*.wav
maia/site/static/**/*.ogg
# except the Maia City circle logo, served from the repo for the fields valley's centre (Samuel, 2026-10-10)
!maia/site/static/sandbox-8/maia-city-circle.png
# and the Sandbox 7 cover, from the fields valley (Samuel, 2026-10-10: the vault copy never reached the server)
!maia/site/static/sandbox-8/cover.jpg
# and the Sandbox 8 cover (folder sandbox-9), which the page's link card points at
!maia/site/static/sandbox-9/cover.jpg
# and the MaiaCity V1 cover, a screenshot of the game, for its Game Worlds card
!maia/site/static/maiacity-v1/cover.jpg
# V2 sunset screenshot: both tents lit, captured from the game renderer.
!maia/site/static/maiacity-v2/cover.jpg
# theOS logo (the Mac app icon set is generated from it, theos/app/icon-source.png).
!maia/site/static/the-os.png
# and its home-screen icons for the pinned site (maia/site/static/manifest.webmanifest, maia/site/app.html), cut from the Mac app's iOS icon
!maia/site/static/icons/*.png
maia/site/static/**/*.pdf

# The local mirror of the media library: every file as <cid>.<ext> (`bun media library`)
/library/

# Voice takes and previews (`bun voice`), film shoots and builds: their bytes live in the media library; the designed
# voices stay in git (maia/content/studio/voices.json)
/studio/*

# the local database's manifest (bun media seed --local): the site loads unsynced files from the local API
/maia/site/lib/media/manifest.local.json

# the background build streams' own working copies (Claude Code worktrees), and Python's cache
/.claude/worktrees/
__pycache__/

# The security tools' build (.claude/skills/security-auditor/tools) and rust-security's scratch results
/.claude/skills/security-auditor/tools/target/
.rust-review-results/

[
	{
		"kind": "manifest",
		"v": 2,
		"note": "What every page reads first: the vault's cap groups, schemas and lenses.",
		"routes": [
			"*"
		],
		"id": "kernel",
		"title": "Kernel",
		"tiers": {
			"now": [
				{
					"want": {
						"type": [
							"capgroup",
							"schema",
							"lens"
						]
					},
					"part": "headers"
				}
			]
		}
	},
	{
		"kind": "manifest",
		"v": 2,

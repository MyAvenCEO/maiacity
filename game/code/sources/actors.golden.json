				}
			]
		}
	},
	{
		"kind": "manifest",
		"v": 2,
		"note": "What the Universe shows first: its newest stories and posts, a page of them, the rest after.",
		"routes": [
			"/universe/",
			"/universe/*"
		],
		"id": "universe",
		"title": "Maia Universe",
		"tiers": {
			"now": [
				{
					"manifest": "kernel"
				},
				{
					"want": {
						"type": [
							"story",
							"post:inspire"
						]
					},
					"window": {
						"newest": 20
					},
					"files": [
						"media:still"
					]
				}
			],
			"later": [
				{
					"want": {
						"type": [
							"story",
							"post:inspire"
						]
					}
				}
			]
		}
	},
	{
		"kind": "manifest",
		"v": 2,
		"note": "Timelines now; the selected one ($timeline) with its shots and stills on open; its sound from the playhead; proxies by the playhead next; originals ($original) on demand; other timelines idle.",
		"routes": [
			"/app/studio/",
			"/app/studio/*"
		],
		"id": "studio",
		"title": "Studio",
		"slots": [
			"timeline",
			"original"
		],
		"tiers": {
			"now": [
				{
					"manifest": "kernel"
				},
				{
					"want": {
						"type": [
							"cut"
						]
					},
					"part": "headers",
					"files": [
						"media:still"
					],
					"note": "names and covers"
				},
				{
					"want": {
						"entry": "$timeline"
					},
					"follow": 2,
					"note": "shots, clips and cut points"
				},
				{
					"want": {
						"entry": "$timeline"
					},
					"follow": 2,
					"part": "files",
					"files": [
						"media:still"
					],
					"note": "one still per shot"
				},
				{
					"want": {
						"entry": "$timeline"
					},
					"follow": 2,
					"part": "files",
					"files": [
						"audio/"
					],
					"by": "playhead",
					"note": "sound from the playhead"
				}
			],
			"next": [
				{
					"want": {
						"entry": "$timeline"
					},
					"follow": 2,
					"part": "files",
					"files": [
						"media:proxy"
					],
					"by": "playhead"
				}
			],
			"later": [
				{
					"want": {
						"entry": "$original"
					},
					"part": "files",
					"files": [
						"media:original"
					],
					"note": "export or full quality only"
				}
			],
			"idle": [
				{
					"want": {
						"type": [
							"cut"
						]
					},
					"follow": 2,
					"part": "files",
					"files": [
						"media:still"
					]
				}
			]
		}
	},
	{
		"kind": "manifest",
		"v": 2,
		"note": "My room list now; the open room ($room) on open, newest messages first; the five most recent other rooms next; its pictures by the viewport later; older history idle.",
		"routes": [
			"/app/chat/",
			"/app/chat/*",
			"/app/#chat"
		],
		"id": "chat",
		"title": "Chat",
		"slots": [
			"room"
		],
		"tiers": {
			"now": [
				{
					"manifest": "kernel"
				},
				{
					"want": {
						"type": [
							"room"
						],
						"vault": "*"
					},
					"part": "headers",
					"note": "names, members, last line, unread"
				},
				{
					"want": {
						"entry": "$room"
					},
					"window": {
						"newest": 50
					},
					"note": "the newest 50 messages and their senders"
				}
			],
			"next": [
				{
					"want": {
						"type": [
							"room"
						],
						"vault": "*"
					},
					"window": {
						"newest": 5
					},
					"note": "the newest messages of the five most recent rooms"
				}
			],
			"later": [
				{
					"want": {
						"entry": "$room"
					},
					"part": "files",
					"files": [
						"media:still",
						"media:preview"
					],
					"by": "viewport"
				},
				{
					"want": {
						"entry": "$room"
					},
					"part": "files",
					"files": [
						"media:original"
					],
					"by": "viewport"
				}
			],
			"idle": [
				{
					"want": {
						"entry": "$room"
					},
					"window": {
						"oldest": true
					},
					"note": "the open room back in time"
				},
				{
					"want": {
						"type": [
							"room"
						],
						"vault": "*"
					},
					"note": "then every room"
				}
			]
		}
	},
	{
		"kind": "manifest",
		"v": 2,
		"note": "The library list now; the selected asset ($asset) with what it pins on select; its neighbours by list position next; its older versions later.",
		"routes": [
			"/app/models/",
			"/app/actors/",

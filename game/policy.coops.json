	"founding": {
		"$description": "What it takes to open a coop: a pitch, the six-field canvas, and the founder's own first conversion of 500 hearts — the founding stake, which takes the coop through its first milestones on the founder's belief alone.",
		"founderStakeHearts": "500",
		"pitchMaxChars": 280,
		"canvas": [
			"who it is for",
			"the problem",
			"the offer",
			"the price",
			"how it reaches them",
			"how it makes money"
		]
	},
	"phases": {
		"$description": "A coop's life in five phases, ten milestones each; the last phase runs to the max supply.",

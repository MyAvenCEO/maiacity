{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The OS",
  "version": "0.1.0",
  "identifier": "city.maia.studio",
  "build": {
    "devUrl": "http://localhost:5173/app/",
    "frontendDist": "../../build",
    "beforeDevCommand": { "script": "bun run dev", "cwd": "../.." },
    "beforeBuildCommand": { "script": "bun run build", "cwd": "../.." }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "The OS",
        "url": "/app/",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval' blob: 'sha256-b5bXsijjyoNtDnH9EUWHyTdZyqHkdVXY5+HUEz5/vNE=' 'sha256-GM+0KFu+6gZBwBoGY6ASD2hjlc4k0S4vphw9WILY9To='",
        "worker-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https: maiaapi: aven:",
        "media-src": "'self' data: blob: https: maiaapi: aven:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost maiaapi: aven: blob: data: https://api.maia.city https://avendb.maia.city wss://avendb.maia.city",
        "frame-src": "'self' blob: https://iframe.mediadelivery.net",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'self'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "externalBin": ["binaries/avendb-device"],
    "category": "Video",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": { "minimumSystemVersion": "13.0" }
  }
}

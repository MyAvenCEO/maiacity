{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "maiaCITY Studio",
  "version": "0.1.0",
  "identifier": "city.maia.studio",
  "build": {
    "devUrl": "http://localhost:5173/app/studio/",
    "frontendDist": "../../build",
    "beforeDevCommand": { "script": "bun run dev", "cwd": "../.." },
    "beforeBuildCommand": { "script": "bun run build", "cwd": "../.." }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "maiaCITY Studio",
        "url": "/app/studio/",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "externalBin": ["binaries/avendb-device"],
    "category": "Video",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": { "minimumSystemVersion": "13.0" }
  }
}

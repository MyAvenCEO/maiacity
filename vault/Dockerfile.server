# vault-server — the media vault's peer on the Hetzner server (built by .github/workflows/api.yml).
# Only this crate is compiled; the Mac-only crates (app, vault-media) are never built here. avenDB's crates sit beside
# the workspace at /avendb only because the app names avendb-device by path and cargo loads every member's manifest.
# cargo-chef keeps the compiled dependencies in their own layer, so a change to our code rebuilds only our crate
# (the layers are cached between CI runs).
FROM lukemathwalker/cargo-chef:latest-rust-1-bookworm AS chef
WORKDIR /src
# each build here is a fresh one: the incremental cache the Mac's release builds keep (Cargo.toml) would only grow the layer
ENV CARGO_INCREMENTAL=0

# avenDB's crates as cargo reads them to load the workspace, and no more: each manifest, the lockfile and every
# target's root, emptied. vault-server links none of them, so an avenDB change (most days several) leaves this the
# same and the compiled dependencies cached, where the whole of avendb/ made them build again (6 minutes) each time.
FROM chef AS avendb
COPY avendb/ /avendb/
RUN cd /avendb \
 && find . -type f ! -name Cargo.toml ! -name Cargo.lock ! -path '*/src/lib.rs' ! -path '*/src/main.rs' ! -path '*/src/bin/*.rs' -delete \
 && find . -name '*.rs' -exec truncate -s 0 {} + \
 && find . -type d -empty -delete

FROM chef AS planner
COPY --from=avendb /avendb/ /avendb/
COPY vault/ ./
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS build
COPY --from=planner /src/recipe.json recipe.json
COPY --from=avendb /avendb/ /avendb/
RUN cargo chef cook --release --locked --package vault-server --recipe-path recipe.json
COPY vault/ ./
RUN cargo build --release --locked -p vault-server && cp target/release/vault-server /vault-server

FROM debian:bookworm-slim
# no media tools: the server does no media work (a file's sound record and its shot analysis are made on a Mac)
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=build /vault-server /usr/local/bin/vault-server
ENV VAULT_DATA=/data
VOLUME /data
# 7400/udp: iroh (direct QUIC from the Macs) · 3340: the relay's HTTP · 3341: the gateway — both behind Caddy
EXPOSE 7400/udp 3340 3341
ENTRYPOINT ["/usr/local/bin/vault-server"]

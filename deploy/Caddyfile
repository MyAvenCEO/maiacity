# Three names, one server. Caddy fetches and renews the certificates itself — passkeys only work in a secure context,
# so HTTPS is not optional here.
#
# The site (maia.city): the built SvelteKit site, static, from /srv/site (the deploy puts each build beside the last
# and switches a link, so a page never points at chunks that are gone). www goes to the bare name.
#
# The API (api.maia.city):
#   /vault/files/<hash>    the site's media (src/lib/media/url.ts): Maia City's public files from avenDB's feed
#                          (/feed/media/<hash>, with Range), by the BLAKE3 hash the old media vault named them by (that
#                          vault and its gateway retired 2026-10-20, #1112)
#   everything else        the API
#
# A browser can't set headers on a WebSocket, so avenDB's relay pass (avendb::sign::RelayPass, ~23 KB, or ~31 KB for
# a pass in each signature suite during the key move) rides in the URL of avendb.maia.city/relay (?token=), and a
# device off the browser sends it as a header as long. Since 2.11, Caddy turns requests that long away (431) unless
# told to read more.
#
# HTTP/3 is off: it rides on UDP 443, which neither the compose file publishes nor the firewall opens. Caddy would
# still offer it in every answer (Alt-Svc), and a browser that takes the offer waits on QUIC that never answers before
# it falls back, as a page's node does on its first ask of the relay.
{
	servers {
		max_header_size 64KB
		protocols h1 h2
	}
}

{$SITE_ADDRESS:maia.city} {
	root * /srv/site/current
	encode zstd gzip
	# the page's own walls (code-architecture/security-audit.md F3): no other site may frame us (a click on Accept in a
	# frame we can't see), no file is read as another type than it says, no plugin objects, no <base> moving our links.
	# Which scripts a page may run comes in the page itself, a <meta> SvelteKit writes with each page's own hashes
	# (src/lib/sandbox/policy.js pageCsp): frame-ancestors can't be said in a <meta>, so it stays here.
	header {
		Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
		X-Frame-Options SAMEORIGIN
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	# hashed chunks never change; pages are looked at again
	@immutable path /_app/immutable/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@pages not path /_app/immutable/*
	header @pages Cache-Control "public, max-age=0, must-revalidate"
	try_files {path} {path}/index.html {path}.html
	file_server
	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}

www.{$SITE_ADDRESS:maia.city} {
	redir https://{$SITE_ADDRESS:maia.city}{uri} permanent
}

# avenDB's relay (avendb.maia.city): the iroh relay inside avendb-server, on a host name of its own, as iroh's relay path
# is /relay and api.maia.city/relay is the media vault's. It holds only ciphertext and lets in only the devices the
# server knows, or a passkey's pass. Its TLS agrees keys by X25519MLKEM768 alone, as avenDB's own links do: a browser
# without it can't reach avenDB.
#   /feed/*        the Maia Universe's feed: the posts the server keeps that everyone may read, as JSON (any page)
#   everything else the relay
{$AVENDB_ADDRESS:avendb.maia.city} {
	tls {
		curves x25519mlkem768
	}
	handle /feed/* {
		encode zstd gzip
		reverse_proxy avendb:3351
	}
	handle {
		reverse_proxy avendb:3350
	}
}

{$API_ADDRESS} {
	# what a browser asks before it reads one of the site's media by Range (its CORS preflight), answered here, as
	# avenDB's feed answers no OPTIONS
	@media_preflight {
		method OPTIONS
		path_regexp ^/vault/files/[0-9a-f]{64}(\.[a-z0-9]+)?$
	}
	handle @media_preflight {
		header Access-Control-Allow-Origin *
		header Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
		header Access-Control-Allow-Headers Range
		header Access-Control-Max-Age 86400
		respond 204
	}
	# the site's media, from avenDB: no key goes on to it, as everyone may read them. Every answer lets any page read
	# it, a refusal too, so a page sees why a file did not load
	@media path_regexp media ^/vault/files/([0-9a-f]{64}(\.[a-z0-9]+)?)$
	handle @media {
		header ?Access-Control-Allow-Origin *
		reverse_proxy avendb:3351 {
			rewrite /feed/media/{re.media.1}
			header_up -Authorization
		}
	}
	handle {
		encode zstd gzip
		reverse_proxy api:3000
	}
}
